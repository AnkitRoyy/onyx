<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="tekno_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-physics-visual-system"
            name="gz::sim::systems::PhysicsVisual"/>
       
        <!-- Buoyancy System -->
    <plugin filename="gz-sim-buoyancy-system"
            name="gz::sim::systems::Buoyancy">
      <!-- Water density -->
      <graded_buoyancy>
        <default_density>4</default_density>

        <!-- Air above water -->
        <density_change>
          <above_depth>0.39</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>

    </plugin>
    <gravity>0 0 -9.81</gravity>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="water_surface">
      <static>true</static>
      <pose>-5.8848 -8 0.2 0 0 0</pose>  <!-- center of the water region -->
      <link name="link">
        <visual name="visual">
          <geometry><box><size>3.2 3 0.4</size></box></geometry>
            <material>
              <ambient>0.1 0.3 0.6 0.5</ambient>
              <diffuse>0.1 0.3 0.6 0.5</diffuse>
              <transparency>0.3</transparency>
            </material>
        </visual>
     </link>
   </model>

    <include>
      <uri>model://course</uri>
      <name>competition_course</name>
      <pose>-8 -8 0.4 0 0 0</pose>
    </include>

  </world>
</sdf>
