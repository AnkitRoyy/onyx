<?xml version="1.0"?>
<sdf version="1.9">

  <model name="course">
    <pose>-8 -8 0.4 0 0 0</pose>
    <static>true</static>

    <link name="course_link">
      <visual name="course_visual">
        <geometry>
          <mesh>
            <uri>meshes/TeknofestTrackFinal.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="course_collision">
        <geometry>
          <mesh>
            <uri>meshes/TeknofestTrackFinal.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.6</mu>
              <mu2>0.6</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
          
    </link>
  </model>
</sdf>
