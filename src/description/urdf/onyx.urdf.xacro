<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="onyx">

      <xacro:property name="robot_mass" value="75.9"/>
    <xacro:property name="wheel_mass" value="3.5"/>
    <xacro:property name="wheel_torque" value="200"/>
    <xacro:property name="mu1" value="1.0"/>
  <xacro:property name="mu2" value="0.6"/>

    <xacro:property name="wheel_radius" value="0.2286"/>     <xacro:property name="wheel_width"  value="0.12"/>
  <xacro:property name="wheel_x"      value="0.4690"/>    <xacro:property name="wheel_y"      value="0.6308"/>    <xacro:property name="track"        value="${2*wheel_y}"/>

    <xacro:property name="body_mass"     value="${robot_mass - 4*wheel_mass}"/>

  <xacro:property name="w_ixx" value="${wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}"/>
  <xacro:property name="w_izz" value="${0.5*wheel_mass*wheel_radius*wheel_radius}"/>

  <material name="body_grey"><color rgba="0.75 0.77 0.80 1"/></material>
  <material name="tyre_black"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="lidar_black"><color rgba="0.12 0.12 0.12 1"/></material>
  <material name="laser_red"><color rgba="0.95 0.05 0.05 1"/></material>

    <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

    <link name="base_link">
    <visual>
      <geometry><mesh filename="package://description/meshes/onyx_body.stl"/></geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <origin xyz="-0.0026 0.0019 0.1808" rpy="0 0 0"/>
      <geometry><box size="0.5591 0.7059 0.3353"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.0150 -0.0031 0.1585" rpy="0 0 0"/>
      <mass value="${body_mass}"/>
      <inertia ixx="${body_mass*0.0465}" ixy="${body_mass*-0.0000}" ixz="${body_mass*0.0002}"
               iyy="${body_mass*0.0516}" iyz="${body_mass*0.0001}" izz="${body_mass*0.0831}"/>
    </inertial>
  </link>
  <gazebo reference="base_link"><material>Gazebo/LightGrey</material></gazebo>

  <link name="lidar_mount">
    <visual>
      <geometry><box size="0.20 0.055 0.035"/></geometry>
      <material name="tyre_black"/>
    </visual>
    <collision>
      <geometry><box size="0.20 0.055 0.035"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="lidar_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_mount"/>
    <origin xyz="0.65 0 0.00" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.045" length="0.07"/></geometry>
      <material name="lidar_black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.045" length="0.07"/></geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.0002" ixy="0" ixz="0"
               iyy="0.0002" iyz="0" izz="0.0003"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_mount"/>
    <child link="lidar_link"/>
    <origin xyz="0.08 0 0.055" rpy="0 0 0"/>
  </joint>
  <gazebo reference="lidar_link">
    <sensor name="front_lidar" type="gpu_lidar">
      <topic>/lidar/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <link name="imu_link">
    <visual>
      <geometry><box size="0.03 0.03 0.015"/></geometry>
      <material name="lidar_black"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0" ixz="0"
               iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.015 -0.0031 0.1585" rpy="0 0 0"/>
  </joint>
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <topic>/imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <always_on>true</always_on>
      <update_rate>100</update_rate>
    </sensor>
  </gazebo>

  <link name="gps_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.03"/></geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.035" length="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00002" ixy="0" ixz="0"
               iyy="0.00002" iyz="0" izz="0.00003"/>
    </inertial>
  </link>

  <link name="front_camera_mount_link">
    <visual>
      <origin xyz="0 0 0.24" rpy="0 0 0"/>
      <geometry><box size="0.03 0.03 0.48"/></geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.24" rpy="0 0 0"/>
      <geometry><box size="0.03 0.03 0.48"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.24" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0058" ixy="0" ixz="0"
               iyy="0.0058" iyz="0" izz="0.00005"/>
    </inertial>
  </link>
  <joint name="front_camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_camera_mount_link"/>
    <origin xyz="0.72 -0.0 0.27" rpy="0 0 0"/>
  </joint>

  <link name="gps_platform_link">
    <visual>
      <geometry><box size="0.14 0.1 0.01"/></geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <geometry><box size="0.24 0.12 0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.000181" ixy="0" ixz="0"
               iyy="0.000721" iyz="0" izz="0.0009"/>
    </inertial>
  </link>
  <joint name="gps_platform_joint" type="fixed">
    <parent link="front_camera_mount_link"/>
    <child link="gps_platform_link"/>
    <origin xyz="-0.05 0 0.475" rpy="0 0 0"/>
  </joint>
  <joint name="gps_joint" type="fixed">
    <parent link="gps_platform_link"/>
    <child link="gps_link"/>
    <origin xyz="-0.02 0 0.02" rpy="0 0 0"/>
  </joint>
  <gazebo reference="gps_link">
    <sensor name="gps_sensor" type="navsat">
      <topic>/gps/fix</topic>
      <gz_frame_id>gps_link</gz_frame_id>
      <always_on>true</always_on>
      <update_rate>5</update_rate>
    </sensor>
  </gazebo>

  <link name="front_camera_link">
    <visual>
      <geometry><box size="0.06 0.05 0.04"/></geometry>
      <material name="lidar_black"/>
    </visual>
    <collision>
      <geometry><box size="0.06 0.05 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0000171" ixy="0" ixz="0"
               iyy="0.0000217" iyz="0" izz="0.0000254"/>
    </inertial>
  </link>
  <joint name="front_camera_joint" type="fixed">
    <parent link="front_camera_mount_link"/>
    <child link="front_camera_link"/>
    <origin xyz="0 0 0.50" rpy="0 0 0"/>
  </joint>
  <gazebo reference="front_camera_link">
    <sensor name="front_cam" type="camera">
      <topic>/front_cam/image</topic>
      <gz_frame_id>front_camera_link</gz_frame_id>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <link name="aiming_turret_support_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.10"/></geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.10"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.00034" ixy="0" ixz="0"
               iyy="0.00034" iyz="0" izz="0.00018"/>
    </inertial>
  </link>
  <joint name="aiming_turret_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="aiming_turret_support_link"/>
    <origin xyz="0.72 0.13 0.27" rpy="0 0 0"/>
  </joint>

  <link name="aiming_turret_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.07" length="0.10"/></geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.07" length="0.10"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="0.75"/>
      <inertia ixx="0.0015" ixy="0" ixz="0"
               iyy="0.0015" iyz="0" izz="0.0018"/>
    </inertial>
  </link>
  <joint name="aiming_turret_joint" type="continuous">
    <parent link="aiming_turret_support_link"/>
    <child link="aiming_turret_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="5" velocity="1.5"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <link name="aiming_tilt_link">
    <visual>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <geometry><box size="0.10 0.08 0.02"/></geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <geometry><box size="0.10 0.08 0.02"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.00009" ixy="0" ixz="0"
               iyy="0.00013" iyz="0" izz="0.00004"/>
    </inertial>
  </link>
  <joint name="aiming_tilt_joint" type="revolute">
    <parent link="aiming_turret_link"/>
    <child link="aiming_tilt_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="5" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <link name="aiming_camera_link">
    <visual>
      <geometry><box size="0.06 0.05 0.04"/></geometry>
      <material name="lidar_black"/>
    </visual>
    <collision>
      <geometry><box size="0.06 0.05 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0000171" ixy="0" ixz="0"
               iyy="0.0000217" iyz="0" izz="0.0000254"/>
    </inertial>
  </link>
  <joint name="aiming_camera_joint" type="fixed">
    <parent link="aiming_tilt_link"/>
    <child link="aiming_camera_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>
  <gazebo reference="aiming_camera_link">
    <sensor name="aiming_cam" type="camera">
      <topic>/aiming_cam/image</topic>
      <gz_frame_id>aiming_camera_link</gz_frame_id>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <link name="aiming_laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.008" length="0.03"/></geometry>
      <material name="laser_red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.008" length="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
               iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="aiming_laser_joint" type="fixed">
    <parent link="aiming_camera_link"/>
    <child link="aiming_laser_link"/>
    <origin xyz="0 0 0.028" rpy="0 0 0"/>
  </joint>

  <link name="rear_camera_link">
    <visual>
      <geometry><box size="0.06 0.05 0.04"/></geometry>
      <material name="lidar_black"/>
    </visual>
    <collision>
      <geometry><box size="0.06 0.05 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0000171" ixy="0" ixz="0"
               iyy="0.0000217" iyz="0" izz="0.0000254"/>
    </inertial>
  </link>
  <joint name="rear_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_camera_link"/>
    <origin xyz="-0.72 -0.0 0.29" rpy="0 0 3.14159"/>
  </joint>
  <gazebo reference="rear_camera_link">
    <sensor name="rear_cam" type="camera">
      <topic>/rear_cam/image</topic>
      <gz_frame_id>rear_camera_link</gz_frame_id>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

    <xacro:macro name="wheel" params="name x y">
    <link name="${name}_wheel">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="tyre_black"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${w_ixx}" ixy="0" ixz="0" iyy="${w_ixx}" iyz="0" izz="${w_izz}"/>
      </inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="${x} ${y} 0" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <gazebo reference="${name}_wheel">
      <mu1>${mu1}</mu1>
      <mu2>${mu2}</mu2>
      <kp>500000.0</kp>
      <kd>10.0</kd>
      <minDepth>0.001</minDepth>
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

    <xacro:wheel name="front_left"  x="${wheel_x}"  y="${wheel_y}"/>
  <xacro:wheel name="front_right" x="${wheel_x}"  y="${-wheel_y}"/>
  <xacro:wheel name="rear_left"   x="${-wheel_x}" y="${wheel_y}"/>
  <xacro:wheel name="rear_right"  x="${-wheel_x}" y="${-wheel_y}"/>

    <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${track}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_acceleration>3</max_linear_acceleration>
      <min_linear_acceleration>-3</min_linear_acceleration>
      <max_angular_acceleration>3</max_angular_acceleration>
      <min_angular_acceleration>-3</min_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <update_rate>50</update_rate>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <joint_name>aiming_turret_joint</joint_name>
      <joint_name>aiming_tilt_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>aiming_turret_joint</joint_name>
      <topic>/turret/yaw/cmd</topic>
      <p_gain>10</p_gain>
      <i_gain>0</i_gain>
      <d_gain>0.5</d_gain>
      <cmd_min>-5</cmd_min>
      <cmd_max>5</cmd_max>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>aiming_tilt_joint</joint_name>
      <topic>/turret/pitch/cmd</topic>
      <p_gain>10</p_gain>
      <i_gain>0</i_gain>
      <d_gain>0.5</d_gain>
      <cmd_min>-5</cmd_min>
      <cmd_max>5</cmd_max>
    </plugin>
  </gazebo>

</robot>
