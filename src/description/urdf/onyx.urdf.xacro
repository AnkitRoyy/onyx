<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="onyx">

      <xacro:property name="robot_mass" value="75.9"/>
    <xacro:property name="wheel_mass" value="3.5"/>
    <xacro:property name="wheel_torque" value="200"/>
    <xacro:property name="mu1" value="1.0"/>
  <xacro:property name="mu2" value="0.6"/>

    <xacro:property name="wheel_radius" value="0.2286"/>     <xacro:property name="wheel_width"  value="0.12"/>
  <xacro:property name="wheel_x"      value="0.4690"/>    <xacro:property name="wheel_y"      value="0.6308"/>    <xacro:property name="track"        value="${2*wheel_y}"/>

    <xacro:property name="body_mass"     value="${robot_mass - 4*wheel_mass}"/>

  <xacro:property name="w_ixx" value="${wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}"/>
  <xacro:property name="w_izz" value="${0.5*wheel_mass*wheel_radius*wheel_radius}"/>

  <material name="body_grey"><color rgba="0.75 0.77 0.80 1"/></material>
  <material name="tyre_black"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="lidar_black"><color rgba="0.12 0.12 0.12 1"/></material>

    <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

    <link name="base_link">
    <visual>
      <geometry><mesh filename="package://description/meshes/onyx_body.stl"/></geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <origin xyz="-0.0026 0.0019 0.1808" rpy="0 0 0"/>
      <geometry><box size="0.5591 0.7059 0.3353"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.0150 -0.0031 0.1585" rpy="0 0 0"/>
      <mass value="${body_mass}"/>
      <inertia ixx="${body_mass*0.0465}" ixy="${body_mass*-0.0000}" ixz="${body_mass*0.0002}"
               iyy="${body_mass*0.0516}" iyz="${body_mass*0.0001}" izz="${body_mass*0.0831}"/>
    </inertial>
  </link>
  <gazebo reference="base_link"><material>Gazebo/LightGrey</material></gazebo>

  <link name="lidar_mount">
    <visual>
      <geometry><box size="0.20 0.055 0.035"/></geometry>
      <material name="tyre_black"/>
    </visual>
    <collision>
      <geometry><box size="0.20 0.055 0.035"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="lidar_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_mount"/>
    <origin xyz="0.65 0 0.00" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.045" length="0.07"/></geometry>
      <material name="lidar_black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.045" length="0.07"/></geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.0002" ixy="0" ixz="0"
               iyy="0.0002" iyz="0" izz="0.0003"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_mount"/>
    <child link="lidar_link"/>
    <origin xyz="0.08 0 0.055" rpy="0 0 0"/>
  </joint>
  <gazebo reference="lidar_link">
    <sensor name="front_lidar" type="lidar">
      <topic>/lidar/scan</topic>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <link name="front_camera_link">
    <visual>
      <geometry><box size="0.06 0.05 0.04"/></geometry>
      <material name="lidar_black"/>
    </visual>
    <collision>
      <geometry><box size="0.06 0.05 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0000171" ixy="0" ixz="0"
               iyy="0.0000217" iyz="0" izz="0.0000254"/>
    </inertial>
  </link>
  <joint name="front_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_camera_link"/>
    <origin xyz="0.72 -0.04 0.29" rpy="0 0 0"/>
  </joint>
  <gazebo reference="front_camera_link">
    <sensor name="front_cam" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50</far>
        </clip>
      </camera>
      <plugin name="front_cam_controller" filename="libgazebo_ros_camera.so">
        <cameraName>front_cam</cameraName>
        <imageTopicName>/front_cam/image_raw</imageTopicName>
        <cameraInfoTopicName>/front_cam/camera_info</cameraInfoTopicName>
        <frameName>front_camera_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <link name="aiming_camera_link">
    <visual>
      <geometry><box size="0.06 0.05 0.04"/></geometry>
      <material name="lidar_black"/>
    </visual>
    <collision>
      <geometry><box size="0.06 0.05 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0000171" ixy="0" ixz="0"
               iyy="0.0000217" iyz="0" izz="0.0000254"/>
    </inertial>
  </link>
  <joint name="aiming_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="aiming_camera_link"/>
    <origin xyz="0.72 0.04 0.29" rpy="0 0 0"/>
  </joint>
  <gazebo reference="aiming_camera_link">
    <sensor name="aiming_cam" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50</far>
        </clip>
      </camera>
      <plugin name="aiming_cam_controller" filename="libgazebo_ros_camera.so">
        <cameraName>aiming_cam</cameraName>
        <imageTopicName>/aiming_cam/image_raw</imageTopicName>
        <cameraInfoTopicName>/aiming_cam/camera_info</cameraInfoTopicName>
        <frameName>aiming_camera_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <link name="rear_camera_link">
    <visual>
      <geometry><box size="0.06 0.05 0.04"/></geometry>
      <material name="lidar_black"/>
    </visual>
    <collision>
      <geometry><box size="0.06 0.05 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0000171" ixy="0" ixz="0"
               iyy="0.0000217" iyz="0" izz="0.0000254"/>
    </inertial>
  </link>
  <joint name="rear_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_camera_link"/>
    <origin xyz="-0.72 -0.0 0.29" rpy="0 0 3.14159"/>
  </joint>
  <gazebo reference="rear_camera_link">
    <sensor name="rear_cam" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50</far>
        </clip>
      </camera>
      <plugin name="rear_cam_controller" filename="libgazebo_ros_camera.so">
        <cameraName>rear_cam</cameraName>
        <imageTopicName>/rear_cam/image_raw</imageTopicName>
        <cameraInfoTopicName>/rear_cam/camera_info</cameraInfoTopicName>
        <frameName>rear_camera_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

    <xacro:macro name="wheel" params="name x y">
    <link name="${name}_wheel">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="tyre_black"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${w_ixx}" ixy="0" ixz="0" iyy="${w_ixx}" iyz="0" izz="${w_izz}"/>
      </inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="${x} ${y} 0" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <gazebo reference="${name}_wheel">
      <mu1>${mu1}</mu1>
      <mu2>${mu2}</mu2>
      <kp>500000.0</kp>
      <kd>10.0</kd>
      <minDepth>0.001</minDepth>
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

    <xacro:wheel name="front_left"  x="${wheel_x}"  y="${wheel_y}"/>
  <xacro:wheel name="front_right" x="${wheel_x}"  y="${-wheel_y}"/>
  <xacro:wheel name="rear_left"   x="${-wheel_x}" y="${wheel_y}"/>
  <xacro:wheel name="rear_right"  x="${-wheel_x}" y="${-wheel_y}"/>

    <gazebo>
    <plugin name="skid_steer_drive" filename="libgazebo_ros_diff_drive.so">
      <update_rate>50</update_rate>
      <num_wheel_pairs>2</num_wheel_pairs>
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${track}</wheel_separation>
      <wheel_separation>${track}</wheel_separation>
      <wheel_diameter>${2*wheel_radius}</wheel_diameter>
      <wheel_diameter>${2*wheel_radius}</wheel_diameter>
      <max_wheel_torque>${wheel_torque}</max_wheel_torque>
      <max_wheel_acceleration>3.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
    </plugin>
  </gazebo>

</robot>
